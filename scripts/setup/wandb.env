# WandB settings for VLAct pretrain (source before launch)
export http_proxy="${http_proxy:-http://10.119.18.5:3128}"
export https_proxy="${https_proxy:-http://10.119.18.5:3128}"
export HTTP_PROXY="${HTTP_PROXY:-${http_proxy}}"
export HTTPS_PROXY="${HTTPS_PROXY:-${https_proxy}}"
export WANDB_MODE="${WANDB_MODE:-online}"
export WANDB_PROJECT="${WANDB_PROJECT:-VLAct_Qwen3_Pretrain}"
# Must match the wandb account in ~/.netrc (currently logged in as app123).
# Inherited WANDB_ENTITY=liujn/jianingliu is a team this API key cannot write.
if [[ -z "${WANDB_ENTITY:-}" || "${WANDB_ENTITY}" == "liujn" || "${WANDB_ENTITY}" == "jianingliu" ]]; then
  export WANDB_ENTITY=app123
fi
# API key: use ~/.netrc (machine api.wandb.ai) or set WANDB_API_KEY
